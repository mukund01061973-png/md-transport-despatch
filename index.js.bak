  db.prepare('INSERT INTO airport_matrix (name, iataCode, keywords, baseRate, tenantId) VALUES (?, ?, ?, ?, ?)').run('Heathrow Airport', 'LHR', 'heathrow, lhr', 140.00, 'MD-BATH');
