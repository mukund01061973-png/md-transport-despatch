                setVal('tfDefaultPricingMode', t.defaultLocalPricingMode || 'dynamic');
                setVal('tfBusySurgePct', t.busySurgePct !== undefined ? t.busySurgePct : 0);

                setVal('tfMeterBaseFare', t.meterBaseFare !== undefined ? t.meterBaseFare : 3.50);
                setVal('tfPulseYard', t.meterDistancePulseYard || 176);
                setVal('tfPulseCost', t.meterDistancePulseCost || 0.20);
                setVal('tfPulseSec', t.meterTimePulseSeconds || 45);

                setVal('tfMeterEstatePct', t.meterEstatePct !== undefined ? t.meterEstatePct : 10);
                setVal('tfMeterMpvPct', t.meterMpvPct !== undefined ? t.meterMpvPct : 40);
                setVal('tfMeterMinibus7Pct', t.meterMinibus7Pct !== undefined ? t.meterMinibus7Pct : 60);
                setVal('tfMeterMinibus8Pct', t.meterMinibus8Pct !== undefined ? t.meterMinibus8Pct : 60);
                setVal('tfMeterExecPct', t.meterExecPct !== undefined ? t.meterExecPct : 70);

                setVal('tfBaseFlagDrop', t.baseFlagDrop !== undefined ? t.baseFlagDrop : 5.00);
                setVal('tfFirstMileRate', t.firstMileRate !== undefined ? t.firstMileRate : 2.00);
                setVal('tfTier1PerMile', t.tier1PerMile !== undefined ? t.tier1PerMile : 2.00);
                setVal('tfTier2PerMile', t.tier2PerMile !== undefined ? t.tier2PerMile : 1.80);
                setVal('tfTier3PerMile', t.tier3PerMile !== undefined ? t.tier3PerMile : 1.50);

                setVal('tfFreeWaitMins', t.freeWaitMins || 5);
                setVal('tfWaitRate', t.waitingRatePerMin || 0.35);
                setVal('tfViaStopFee', t.viaStopFee || 5.00);
                setVal('tfPetSurcharge', t.petSurcharge || 6.00);

                setVal('tfEstatePct', ((t.estatePercent || 0.10) * 100).toFixed(0));
                setVal('tfMpvPct', ((t.mpvPercent || 0.40) * 100).toFixed(0));
                setVal('tfMinibus7Pct', ((t.minibus7Percent || 0.60) * 100).toFixed(0));
                setVal('tfMinibus8Pct', ((t.minibus8Percent || 0.60) * 100).toFixed(0));
                setVal('tfExecPct', ((t.execPercent || 0.70) * 100).toFixed(0));

                setVal('tfAirportEstatePct', ((t.airportEstatePercent !== undefined ? t.airportEstatePercent : 0.10) * 100).toFixed(0));
                setVal('tfAirportMpvPct', ((t.airportMpvPercent !== undefined ? t.airportMpvPercent : 0.45) * 100).toFixed(0));
                setVal('tfAirportMinibus7Pct', ((t.airportMinibus7Percent !== undefined ? t.airportMinibus7Percent : 0.60) * 100).toFixed(0));
                setVal('tfAirportMinibus8Pct', ((t.airportMinibus8Percent !== undefined ? t.airportMinibus8Percent : 0.60) * 100).toFixed(0));
                setVal('tfAirportExecPct', ((t.airportExecPercent !== undefined ? t.airportExecPct : 0.70) * 100).toFixed(0));

                if (t.defaultLocalPricingMode) {
                    document.getElementById('pricingModeToggle').value = t.defaultLocalPricingMode;
                }
                renderAirportsTable();
                recalculateDispatchFare();
            }
        });

