            res.completedJobs.forEach(job => {
                tbody.innerHTML += `
                    <tr>
                        <td><strong>${job.id}</strong></td>
                        <td><small style="color:#94a3b8;">${job.completedAt || job.createdAt}</small></td>
                        <td>${job.passenger}</td>
                        <td><small>${job.pickup} ➔ ${job.dropoff}</small></td>
                        <td><span class="badge ${job.paymentMethod === 'Cash' ? 'badge-yellow' : 'badge-blue'}">${job.paymentMethod}</span></td>
                        <td><strong>£${Number(job.fare).toFixed(2)}</strong></td>
                    </tr>
                `;
            });
        });

        // CENTRAL PROGRESSIVE DISTANCE CALCULATION
        function calculateProgressiveTariff(miles, vehicleClass = 'Saloon', numVias = 0, hasPet = false) {
            const baseFee = parseFloat(document.getElementById('tfBaseFlagDrop').value) || 5.00;
            const firstMileRate = parseFloat(document.getElementById('tfFirstMileRate').value) || 2.00;
            const tier1Rate = parseFloat(document.getElementById('tfTier1PerMile').value) || 2.00;
            const tier2Rate = parseFloat(document.getElementById('tfTier2PerMile').value) || 1.80;
            const tier3Rate = parseFloat(document.getElementById('tfTier3PerMile').value) || 1.50;
            const viaStopFee = parseFloat(document.getElementById('tfViaStopFee').value) || 5.00;
            const petFee = parseFloat(document.getElementById('tfPetSurcharge').value) || 6.00;
            const busySurgePct = parseFloat(document.getElementById('tfBusySurgePct').value) || 0.0;

            let distanceCost = 0.0;
            if (miles <= 0) return baseFee;

            if (miles <= 25) {
                distanceCost = (miles <= 1) ? firstMileRate * miles : firstMileRate + ((miles - 1) * tier1Rate);
            } else if (miles <= 50) {
                const tier1Total = firstMileRate + (24 * tier1Rate);
                const tier2Miles = miles - 25;
                distanceCost = tier1Total + (tier2Miles * tier2Rate);
            } else {
                const tier1Total = firstMileRate + (24 * tier1Rate);
                const tier2Total = 25 * tier2Rate;
                const tier3Miles = miles - 50;
                distanceCost = tier1Total + tier2Total + (tier3Miles * tier3Rate);
            }

            let subtotal = baseFee + distanceCost;
            let multiplier = 1.0;
            if (vehicleClass === 'ANY' || vehicleClass === 'LOW_CAR' || vehicleClass === 'Saloon') multiplier = 1.0;
            else if (vehicleClass === 'Estate') multiplier += (parseFloat(document.getElementById('tfEstatePct').value) || 10) / 100.0;
            else if (vehicleClass === 'MPV_6') multiplier += (parseFloat(document.getElementById('tfMpvPct').value) || 40) / 100.0;
            else if (vehicleClass === 'Minibus_7') multiplier += (parseFloat(document.getElementById('tfMinibus7Pct').value) || 60) / 100.0;
            else if (vehicleClass === 'Minibus_8') multiplier += (parseFloat(document.getElementById('tfMinibus8Pct').value) || 60) / 100.0;
            else if (vehicleClass === 'Executive') multiplier += (parseFloat(document.getElementById('tfExecPct').value) || 70) / 100.0;

            let baseFare = (subtotal * multiplier) + (numVias * viaStopFee) + (hasPet ? petFee : 0);
            if (busySurgePct > 0) baseFare = baseFare * (1 + (busySurgePct / 100.0));
            return parseFloat(baseFare.toFixed(2));
        }

        window.addEventListener('DOMContentLoaded', () => {
            map = L.map('mapContainer').setView([51.3776, -2.3571], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
        });

        function toggleMenu(menuId, event) {
            if (event) event.stopPropagation();
            const target = document.getElementById(menuId);
            const isOpen = target.classList.contains('show');
            document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
            if (!isOpen) target.classList.add('show');
        }

