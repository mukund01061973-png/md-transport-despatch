<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MD Transport Master Dispatch Control</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0b1120; color: #ffffff; margin: 0; padding: 0; font-size: 13px; }
        
        .app-menubar {
            background: #1e293b;
            border-bottom: 1px solid #334155;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 16px;
            height: 42px;
            position: sticky;
            top: 0;
            z-index: 500;
        }
        .menubar-left { display: flex; align-items: center; gap: 16px; }
        .brand-title { color: #38bdf8; font-weight: 800; font-size: 0.95rem; letter-spacing: 0.5px; }

        .menu-item { position: relative; }
        .menu-btn {
            background: transparent;
            color: #cbd5e1;
            border: none;
            padding: 8px 12px;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
            height: 32px;
        }
        .menu-btn:hover { background: #334155; color: #ffffff; }

        .dropdown-menu {
            display: none;
            position: absolute;
            top: 36px;
            left: 0;
            background: #1e293b;
            border: 1px solid #475569;
            border-radius: 6px;
            min-width: 290px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.6);
            z-index: 1000;
            padding: 4px 0;
        }
        .dropdown-menu.show { display: block; }
        .dropdown-item {
            padding: 8px 14px;
            color: #e2e8f0;
            display: block;
            cursor: pointer;
            font-size: 0.82rem;
            text-decoration: none;
        }
        .dropdown-item:hover { background: #0284c7; color: #ffffff; }

        .workspace-container { padding: 12px 16px; }
        .workspace-grid { display: grid; grid-template-columns: 440px 1fr; gap: 14px; }
        .card { background: #1e293b; border-radius: 8px; padding: 14px; border: 1px solid #334155; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3); }

        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
        .grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; }

        label { display: block; color: #94a3b8; margin-bottom: 3px; font-weight: 500; font-size: 0.76rem; }
        input, select, textarea, button { width: 100%; padding: 7px 9px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: #ffffff; margin-bottom: 8px; outline: none; font-size: 0.82rem; }
        input:focus, select:focus, textarea:focus { border-color: #38bdf8; }

        button { background: #0284c7; color: white; border: none; font-weight: bold; cursor: pointer; transition: 0.15s; }
        button:hover { background: #0369a1; }
        .btn-green { background: #10b981; } .btn-green:hover { background: #059669; }
        .btn-red { background: #ef4444; } .btn-red:hover { background: #dc2626; }
        .btn-orange { background: #f59e0b; color: #000; } .btn-orange:hover { background: #d97706; }
        .btn-purple { background: #8b5cf6; } .btn-purple:hover { background: #7c3aed; }
        .btn-blue { background: #0284c7; } .btn-blue:hover { background: #0369a1; }
        .btn-pill { width: auto; padding: 3px 10px; border-radius: 16px; font-size: 0.72rem; border: 1px solid #334155; background: #0f172a; color: #94a3b8; display: inline-block; cursor: pointer; margin: 0; }
        .btn-pill.active { background: #0284c7; color: #fff; border-color: #38bdf8; }

        table { width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 0.8rem; }
        th, td { padding: 6px 8px; text-align: left; border-bottom: 1px solid #334155; }
        th { background-color: #0f172a; color: #38bdf8; font-weight: 600; }
        .badge { padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; text-transform: uppercase; display: inline-block; }
        .badge-green { background: #064e3b; color: #34d399; }
        .badge-blue { background: #0c4a6e; color: #38bdf8; }
        .badge-yellow { background: #78350f; color: #fde047; }
        .badge-red { background: #7f1d1d; color: #fca5a5; }

        #mapContainer { height: 230px; width: 100%; border-radius: 6px; border: 1px solid #334155; margin-bottom: 12px; }

        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 2000; justify-content: center; align-items: flex-start; padding: 20px; overflow-y: auto; }
        .modal-card { background: #1e293b; border: 2px solid #38bdf8; border-radius: 10px; max-width: 900px; width: 100%; max-height: 88vh; overflow-y: auto; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.9); margin-top: 15px; }

        .typeahead-wrap { position: relative; width: 100%; }
        .typeahead-list {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #0f172a;
            border: 1px solid #38bdf8;
            border-radius: 0 0 6px 6px;
            max-height: 180px;
            overflow-y: auto;
            z-index: 1500;
            box-shadow: 0 8px 16px rgba(0,0,0,0.8);
            margin-top: -6px;
            padding: 0;
            list-style: none;
        }
        .typeahead-item { padding: 8px 10px; font-size: 0.78rem; cursor: pointer; border-bottom: 1px solid #1e293b; color: #cbd5e1; }
        .typeahead-item:hover { background: #0284c7; color: #ffffff; }

        .timeline-item { border-left: 2px solid #38bdf8; padding-left: 12px; margin-bottom: 10px; position: relative; }
        .timeline-item::before { content: ''; width: 8px; height: 8px; background: #38bdf8; border-radius: 50%; position: absolute; left: -5px; top: 4px; }
    </style>
</head>
<body>

    <!-- TOP MENU WITH MULTI-TENANT SWITCHER -->
    <div class="app-menubar">
        <div class="menubar-left">
            <span class="brand-title">🚕 MD TRANSPORT MASTER DISPATCH</span>

            <!-- TENANT SELECTOR -->
            <select id="tenantSelect" onchange="switchTenant()" style="width:130px; margin:0; padding:4px 6px; font-size:0.75rem; background:#0f172a; border-color:#0284c7; color:#38bdf8; font-weight:bold;">
                <option value="MD-BATH" selected>📍 Bath Fleet</option>
                <option value="MD-BRISTOL">📍 Bristol Fleet</option>
                <option value="MD-LONDON">📍 London Fleet</option>
            </select>

            <div class="menu-item">
                <button type="button" class="menu-btn" onclick="toggleMenu('menuTariffs', event)">⚙️ Tariffs & Live Meter ▾</button>
                <div id="menuTariffs" class="dropdown-menu">
                    <div class="dropdown-item" onclick="openAppModal('modalTariff')">📊 Progressive 3-Tier Tariffs, Live Meter & Busy Surge</div>
                    <div class="dropdown-item" onclick="openAppModal('modalAirports')">✈️ Airport Matrix (Fixed Routes & Uplifts)</div>
                </div>
            </div>

            <div class="menu-item">
                <button type="button" class="menu-btn" onclick="toggleMenu('menuFleet', event)">🚗 Fleet & Stands ▾</button>
                <div id="menuFleet" class="dropdown-menu">
                    <div class="dropdown-item" onclick="openAppModal('modalDrivers')">🚘 Driver Profiles & MOT/Badge Compliance</div>
                    <div class="dropdown-item" onclick="openAppModal('modalPlots')">📍 Taxi Stands & FIFO Queues</div>
                    <div class="dropdown-item" onclick="openDriverStatementModal()">📑 Driver Pay & Commission Statements</div>
                </div>
            </div>

            <div class="menu-item">
                <button type="button" class="menu-btn" onclick="toggleMenu('menuAccounts', event)">🏢 Corporate ▾</button>
                <div id="menuAccounts" class="dropdown-menu">
                    <div class="dropdown-item" onclick="openAppModal('modalAccounts')">📑 Corporate Accounts & Billing</div>
                    <div class="dropdown-item" onclick="openAppModal('modalInvoiceGenerator')">🧾 Generate Monthly Invoices</div>
                </div>
            </div>
        </div>

        <div><span id="connStatus" class="badge badge-green">Connected Live</span></div>
    </div>

    <!-- MAIN CONSOLE -->
    <div class="workspace-container">
        <div class="workspace-grid">
            
            <!-- LEFT: DISPATCH DESK -->
            <div class="card">
                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #334155; padding-bottom:6px; margin-bottom:8px;">
                    <h3 style="margin:0; color:#38bdf8; font-size:0.95rem;">📝 Dispatch Desk</h3>
                    <select id="pricingModeToggle" onchange="switchPricingMode()" style="width:190px; margin:0; padding:4px; font-size:0.75rem;">
                        <option value="dynamic" selected>⚡ Progressive 3-Tier Distance</option>
                        <option value="meter">⏱️ Live Pulse Meter</option>
                        <option value="custom">✏️ Custom Fixed</option>
                    </select>
                </div>

                <form id="bookingForm" onsubmit="createJob(event)">
                    <div class="grid-2">
                        <div><label>Passenger Name:</label><input type="text" id="jobPassenger" placeholder="John Smith" required></div>
                        <div><label>Phone Number:</label><input type="tel" id="jobPhone" placeholder="07795681747" required></div>
                    </div>

                    <div class="grid-2">
                        <div>
                            <label>Payment Mode:</label>
                            <select id="jobPayMethod">
                                <option value="Cash">💵 Cash to Driver</option>
                                <option value="Card in Car">💳 Card to Driver</option>
                                <option value="Prepaid Online">🔒 Prepaid / Link</option>
                                <option value="Corporate Account">🏢 Corporate Account</option>
                            </select>
                        </div>
                        <div>
                            <label>Corporate Account:</label>
                            <select id="jobAccountSelect" onchange="recalculateDispatchFare()">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid-2" style="background:#0f172a; padding:6px; border-radius:6px; margin-bottom:6px; border:1px solid #334155;">
                        <div>
                            <label>🐾 Pet Passenger:</label>
                            <select id="jobPetType" onchange="recalculateDispatchFare()" style="margin:0;">
                                <option value="None">No Pets</option>
                                <option value="Dog">Dog (+Surcharge)</option>
                                <option value="Cat">Cat (+Surcharge)</option>
                                <option value="GuideDog">Guide Dog (Free - Law)</option>
                            </select>
                        </div>
                        <div>
                            <label>Vehicle Category:</label>
                            <select id="jobVehClass" onchange="recalculateDispatchFare()" style="margin:0;">
                                <option value="ANY" selected>🚗 Any Vehicle (Standard Low Fare)</option>
                                <option value="LOW_CAR">🚙 Low Car (Saloon / Estate Only)</option>
                                <option value="Saloon">🚙 Saloon Car</option>
                                <option value="Estate">📦 Estate Car (+10%)</option>
                                <option value="MPV_6">👨‍👩‍👧‍👦 6-Seat MPV (+40%)</option>
                                <option value="Minibus_7">🚐 7-Seat Minibus (+60%)</option>
                                <option value="Minibus_8">🚐 8-Seat Minibus (+60%)</option>
                                <option value="Executive">⭐ Executive VIP (+70%)</option>
                            </select>
                        </div>
                    </div>

                    <div class="grid-2">
                        <div>
                            <label>Passengers:</label>
                            <select id="jobPax" onchange="recalculateDispatchFare()">
                                <option value="1">1 Pax</option>
                                <option value="4" selected>4 Pax</option>
                                <option value="6">6 Pax</option>
                                <option value="7">7 Pax</option>
                                <option value="8">8 Pax</option>
                            </select>
                        </div>
                        <div style="display:flex; align-items:center; gap:6px; margin-top:16px;">
                            <input type="checkbox" id="jobStrictVeh" style="width:auto; margin:0;" onchange="recalculateDispatchFare()">
                            <label for="jobStrictVeh" style="margin:0; font-size:0.75rem; color:#fde047;">Strict Vehicle Only</label>
                        </div>
                    </div>

                    <label>Pickup Location:</label>
                    <div class="typeahead-wrap">
                        <input type="text" id="jobPickup" placeholder="e.g. Bath Spa Station or BA1 1SU" oninput="handleAddressTypeahead(this, 'pickupList')" autocomplete="off" required>
                        <ul id="pickupList" class="typeahead-list"></ul>
                    </div>

                    <div id="viasContainer"></div>
                    <button type="button" class="btn-orange" style="width:auto; padding:3px 8px; font-size:0.75rem; margin-bottom:6px;" onclick="addViaStopField()">+ Add Via Stop</button>

                    <label>Destination Location:</label>
                    <div class="typeahead-wrap">
                        <input type="text" id="jobDropoff" placeholder="e.g. Heathrow Airport or BA1 6BA" oninput="handleAddressTypeahead(this, 'dropoffList')" autocomplete="off" required>
                        <ul id="dropoffList" class="typeahead-list"></ul>
                    </div>

                    <label>Notes / Driver Instructions:</label>
                    <input type="text" id="jobNotes" placeholder="e.g. Meet inside Costa">

                    <div style="background:#0f172a; border:1px solid #0284c7; border-radius:6px; padding:6px 8px; margin-bottom:8px; display:flex; justify-content:space-between; align-items:center;">
                        <span style="font-size:0.75rem; color:#94a3b8;" id="dispatchDistLabel">0.0 Miles (0 Vias)</span>
                        <span style="font-size:0.75rem; color:#38bdf8; font-weight:bold;" id="dispatchPricingLabel">Progressive 3-Tier</span>
                    </div>

                    <label>Agreed Fare (£):</label>
                    <input type="text" id="jobFare" value="15.00" required>

                    <label>Assign Driver:</label>
                    <select id="jobAssignDriver">
                        <option value="UNASSIGNED">⚡ Auto-Match FIFO Queue (15s Cascade ➔ Bid Board)</option>
                    </select>

                    <button type="submit" class="btn-green" id="btnSubmitDispatch">⚡ Dispatch Booking</button>
                </form>
            </div>

            <!-- RIGHT: LIVE LEDGER & MAP -->
            <div style="display:flex; flex-direction:column; gap:12px;">
                <div class="card" style="padding:10px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <h3 style="margin:0; color:#38bdf8; font-size:0.92rem;">🗺️ Live Vehicle Map</h3>
                    </div>
                    <div id="mapContainer"></div>
                </div>

                <div class="card">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                        <h3 style="margin:0; color:#38bdf8; font-size:0.95rem;">📋 Live Booking Ledger</h3>
                        <div style="display:flex; gap:4px;">
                            <button type="button" class="btn-pill active" onclick="filterJobs('all', this)">All</button>
                            <button type="button" class="btn-pill" onclick="filterJobs('active', this)">🟢 Active</button>
                            <button type="button" class="btn-pill" onclick="filterJobs('completed', this)">✅ Completed</button>
                        </div>
                    </div>

                    <div style="overflow-x:auto; max-height:280px; overflow-y:auto;">
                        <table>
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Passenger</th>
                                    <th>Route & Stops</th>
                                    <th>Driver</th>
                                    <th>Fare</th>
                                    <th>Status</th>
                                    <th style="text-align:center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="jobsTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MODAL: MASTER TARIFF -->
    <div id="modalTariff" class="modal-overlay" onclick="closeOverlayModal(event, 'modalTariff')">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #334155; padding-bottom:8px; margin-bottom:12px;">
                <h3 style="margin:0; color:#38bdf8;">📊 Master Tariffs, Live Meter & Busy Time Surge</h3>
                <button type="button" class="btn-red" style="width:auto; padding:3px 8px;" onclick="closeAppModal('modalTariff')">✕</button>
            </div>
            
            <form onsubmit="saveTariff(event)">
                <h4 style="color:#fde047; margin:4px 0 8px 0;">1. Live Digital Pulse Meter Settings</h4>
                <div class="grid-5">
                    <div>
                        <label>Default Mode:</label>
                        <select id="tfDefaultPricingMode">
                            <option value="dynamic" selected>⚡ Progressive Distance</option>
                            <option value="meter">⏱️ Digital Pulse Meter</option>
                        </select>
                    </div>
                    <div><label style="color:#34d399; font-weight:bold;">Meter Base Drop (£):</label><input type="number" step="0.05" id="tfMeterBaseFare" value="3.50" required></div>
                    <div><label>Dist Pulse (Yards):</label><input type="number" id="tfPulseYard" value="176" required></div>
                    <div><label>Dist Pulse Cost (£):</label><input type="number" step="0.01" id="tfPulseCost" value="0.20" required></div>
                    <div><label>Time Pulse (Sec):</label><input type="number" id="tfPulseSec" value="45" required></div>
                </div>

                <div style="margin-top:6px;">
                    <label style="color:#38bdf8; font-weight:bold;">Live Meter Vehicle Category Uplifts (0% - 100%):</label>
                    <div class="grid-5">
                        <div><label>Meter Estate (+%):</label><input type="number" id="tfMeterEstatePct" value="10" required></div>
                        <div><label>Meter MPV 6 (+%):</label><input type="number" id="tfMeterMpvPct" value="40" required></div>
                        <div><label>Meter Minibus 7 (+%):</label><input type="number" id="tfMeterMinibus7Pct" value="60" required></div>
                        <div><label>Meter Minibus 8 (+%):</label><input type="number" id="tfMeterMinibus8Pct" value="60" required></div>
                        <div><label>Meter Exec (+%):</label><input type="number" id="tfMeterExecPct" value="70" required></div>
                    </div>
                </div>

                <hr style="border:0; border-top:1px solid #334155; margin:10px 0;">
                <h4 style="color:#f59e0b; margin:6px 0;">2. Peak / Busy Time Surcharge & Surcharges</h4>
                <div class="grid-5">
                    <div><label style="color:#fde047; font-weight:bold;">⚡ Busy Surge (%):</label><input type="number" step="1" id="tfBusySurgePct" value="0" required></div>
                    <div><label>Free Wait (Mins):</label><input type="number" id="tfFreeWaitMins" value="5" required></div>
                    <div><label>Wait Rate (£/Min):</label><input type="number" step="0.05" id="tfWaitRate" value="0.35" required></div>
                    <div><label>Stop-Over Fee (£):</label><input type="number" step="0.5" id="tfViaStopFee" value="5.00" required></div>
                    <div><label>Pet Surcharge (£):</label><input type="number" step="0.5" id="tfPetSurcharge" value="6.00" required></div>
                </div>

                <hr style="border:0; border-top:1px solid #334155; margin:10px 0;">
                <h4 style="color:#38bdf8; margin:6px 0;">3. Progressive Distance Engine Rates</h4>
                <div class="grid-2">
                    <div><label style="color:#34d399; font-weight:bold;">Distance Base Flag Drop (£):</label><input type="number" step="0.05" id="tfBaseFlagDrop" value="5.00" required></div>
                    <div><label style="color:#34d399; font-weight:bold;">First Mile Rate (Mile 0 to 1) (£):</label><input type="number" step="0.05" id="tfFirstMileRate" value="2.00" required></div>
                </div>

                <div class="grid-3" style="margin-top:6px;">
                    <div><label>Tier 1 (Miles 1 to 25) Rate (£/mi):</label><input type="number" step="0.05" id="tfTier1PerMile" value="2.00" required></div>
                    <div><label>Tier 2 (Miles 25 to 50) Rate (£/mi):</label><input type="number" step="0.05" id="tfTier2PerMile" value="1.80" required></div>
                    <div><label>Tier 3 (Miles Over 50) Rate (£/mi):</label><input type="number" step="0.05" id="tfTier3PerMile" value="1.50" required></div>
                </div>

                <div style="margin-top:6px;">
                    <label style="color:#38bdf8; font-weight:bold;">Distance Vehicle Category Uplifts (0% - 100%):</label>
                    <div class="grid-5">
                        <div><label>Estate (+%):</label><input type="number" id="tfEstatePct" value="10" required></div>
                        <div><label>MPV (+%):</label><input type="number" id="tfMpvPct" value="40" required></div>
                        <div><label>Minibus 7 (+%):</label><input type="number" id="tfMinibus7Pct" value="60" required></div>
                        <div><label>Minibus 8 (+%):</label><input type="number" id="tfMinibus8Pct" value="60" required></div>
                        <div><label>Exec (+%):</label><input type="number" id="tfExecPct" value="70" required></div>
                    </div>
                </div>

                <hr style="border:0; border-top:1px solid #334155; margin:12px 0;">
                <h4 style="color:#38bdf8; margin:6px 0;">4. Airport Matrix Rate Uplifts (0% - 100%)</h4>
                <div class="grid-5">
                    <div><label>Airport Estate (+%):</label><input type="number" id="tfAirportEstatePct" value="10" required></div>
                    <div><label>Airport MPV (+%):</label><input type="number" id="tfAirportMpvPct" value="45" required></div>
                    <div><label>Airport Minibus 7 (+%):</label><input type="number" id="tfAirportMinibus7Pct" value="60" required></div>
                    <div><label>Airport Minibus 8 (+%):</label><input type="number" id="tfAirportMinibus8Pct" value="60" required></div>
                    <div><label>Airport Exec (+%):</label><input type="number" id="tfAirportExecPct" value="70" required></div>
                </div>

                <div style="margin-top: 15px; padding-bottom: 25px;">
                    <button type="submit" class="btn-green" style="padding:12px; font-size:0.95rem;">💾 Save Complete Tariffs</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: DRIVER PROFILES WITH MOT / BADGE COMPLIANCE TRACKER -->
    <div id="modalDrivers" class="modal-overlay" onclick="closeOverlayModal(event, 'modalDrivers')">
        <div class="modal-card" onclick="event.stopPropagation()">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #334155; padding-bottom:8px; margin-bottom:12px;">
                <h3 style="margin:0; color:#38bdf8;">🚗 Driver Roster & Document Compliance Tracker</h3>
                <button type="button" class="btn-red" style="width:auto; padding:3px 8px;" onclick="closeAppModal('modalDrivers')">✕</button>
            </div>

            <form onsubmit="saveDriver(event)" style="background:#0f172a; padding:12px; border-radius:6px; margin-bottom:14px; border:1px solid #334155;">
                <h4 style="color:#fde047; margin:0 0 8px 0;">Register New Driver:</h4>
                <div class="grid-4">
                    <div><label>Callsign / ID:</label><input type="text" id="drvId" placeholder="e.g. UKUND" required></div>
                    <div><label>Driver Full Name:</label><input type="text" id="drvName" placeholder="Mukund Desai" required></div>
                    <div><label>Mobile Number:</label><input type="tel" id="drvPhone" placeholder="07795681747" required></div>
                    <div><label>PIN (4 Digits):</label><input type="password" id="drvPin" placeholder="1234" required></div>
                </div>
                <div class="grid-4">
                    <div><label>Vehicle Model:</label><input type="text" id="drvVehicle" placeholder="Hyundai i800" required></div>
                    <div>
                        <label>Vehicle Class:</label>
                        <select id="drvClass">
                            <option value="Saloon">Saloon</option>
                            <option value="Estate">Estate</option>
                            <option value="MPV_6">6-Seat MPV</option>
                            <option value="Minibus_7">7-Seat Minibus</option>
                            <option value="Minibus_8" selected>8-Seat Minibus</option>
                            <option value="Executive">Executive VIP</option>
                        </select>
                    </div>
                    <div><label>Max Pax:</label><input type="number" id="drvMaxPax" value="8" required></div>
                    <div><label>Commission Cut (%):</label><input type="number" step="0.5" id="drvCommPct" value="20.0" required></div>
                </div>
                
                <!-- COMPLIANCE DATES -->
                <div class="grid-4" style="background:#1e293b; padding:8px; border-radius:6px; margin-bottom:8px; border:1px solid #334155;">
                    <div><label style="color:#fde047;">PHV/Hackney Badge Expiry:</label><input type="date" id="drvBadgeExp" required></div>
                    <div><label style="color:#fde047;">Vehicle MOT Expiry:</label><input type="date" id="drvMotExp" required></div>
                    <div><label style="color:#fde047;">Insurance Policy Expiry:</label><input type="date" id="drvInsExp" required></div>
                    <div><label>Pet Friendly:</label><select id="drvAcceptsPets"><option value="1" selected>Yes</option><option value="0">No</option></select></div>
                </div>

                <button type="submit" class="btn-green" style="margin:0;">➕ Register Driver & Track Compliance</button>
            </form>

            <div style="overflow-x:auto;">
