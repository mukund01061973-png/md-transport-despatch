        function renderJobsTable() {
            const tbody = document.getElementById('jobsTableBody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const filtered = allJobs.filter(j => {
                if (currentFilter === 'active') return j.status === 'Accepted' || j.status === 'Arrived' || j.status === 'POB';
                if (currentFilter === 'completed') return j.status === 'Completed';
                return true;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:#64748b; padding:12px;">No bookings found.</td></tr>';
                return;
            }

            filtered.forEach(job => {
                const isActive = (job.status !== 'Completed' && job.status !== 'Cancelled');
                const viasArr = JSON.parse(job.vias || '[]');
                const viasBadge = viasArr.length > 0 ? `<br><small style="color:#fde047;">🛑 ${viasArr.length} Via Stop(s)</small>` : '';

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${job.id}</strong><br><small style="color:#94a3b8;">${job.createdAt}</small></td>
                        <td><strong>${job.passenger}</strong><br><small style="color:#38bdf8;">${job.phone}</small></td>
                        <td><strong>P:</strong> ${job.pickup}<br><strong>D:</strong> ${job.dropoff} ${viasBadge}</td>
                        <td><strong style="color:#38bdf8;">${job.assignedDriverId || 'Unassigned'}</strong></td>
                        <td><strong>£${Number(job.fare).toFixed(2)}</strong></td>
                        <td><span class="badge badge-${job.status === 'Completed' ? 'green' : (job.status === 'Accepted' ? 'blue' : 'yellow')}">${job.status}</span></td>
                        <td style="white-space:nowrap; text-align:center;">
                            <button type="button" class="btn-blue" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="openLiveTrackingLink('${job.id}')" title="Customer Live Tracking">📍 Track</button>
                            <button type="button" class="btn-green" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="cloneAsReturnJob('${job.id}')" title="One-Click Return Trip">🔁 Return</button>
                            <button type="button" class="btn-orange" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="openAmendModal('${job.id}')" title="Amend Route & Stops">✏️ Amend</button>
                            ${isActive ? `
                                <button type="button" class="btn-purple" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="openReassignModal('${job.id}')" title="Reassign or Recall">🔄 Reassign</button>
                                <button type="button" class="btn-red" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="openCancelModal('${job.id}')" title="Cancel">❌ Cancel</button>
                            ` : ''}
                            <button type="button" class="btn-blue" style="width:auto; padding:2px 6px; margin:0 1px; font-size:0.75rem;" onclick="openTripHistoryModal('${job.id}')" title="View Full History">📜 History</button>
                        </td>
                    </tr>
                `;
            });
        }

        function openAmendModal(jobId) {
            const j = allJobs.find(x => x.id === jobId);
            if (!j) return;
            document.getElementById('amendJobId').value = j.id;
            document.getElementById('amendPassenger').value = j.passenger;
            document.getElementById('amendPhone').value = j.phone;
            document.getElementById('amendVehClass').value = j.vehicleClass || 'ANY';
            document.getElementById('amendPickup').value = j.pickup;
            document.getElementById('amendDropoff').value = j.dropoff;
            document.getElementById('amendFare').value = j.fare;
            document.getElementById('amendNotes').value = j.customerNotes || '';

            const wrap = document.getElementById('amendViasContainer');
            wrap.innerHTML = '';
            const vias = JSON.parse(j.vias || '[]');
            vias.forEach(v => addAmendViaField(v));

            openAppModal('modalAmendJob');
        }

        async function recalcAmendRoute() {
            const pickup = document.getElementById('amendPickup').value.trim();
            const dropoff = document.getElementById('amendDropoff').value.trim();
            const vias = Array.from(document.querySelectorAll('.amend-via-input')).map(i => i.value.trim()).filter(v => v !== '');
            const vClass = document.getElementById('amendVehClass').value;

            if (!pickup || !dropoff) return;
            const stops = [pickup, ...vias, dropoff];

            try {
                const geocode = async (addr) => {
                    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&countrycodes=gb&limit=1&q=${encodeURIComponent(addr)}`);
                    const d = await res.json();
                    return (d && d.length > 0) ? `${d[0].lon},${d[0].lat}` : null;
                };
                const coords = await Promise.all(stops.map(s => geocode(s)));
                if (coords.every(c => c !== null)) {
                    const rRes = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords.join(';')}?overview=false`);
                    const rData = await rRes.json();
                    if (rData.routes && rData.routes.length > 0) {
                        const miles = parseFloat((rData.routes[0].distance * 0.000621371).toFixed(1));
                        const fare = calculateProgressiveTariff(miles, vClass, vias.length, false);
                        document.getElementById('amendFare').value = fare.toFixed(2);
                    }
                }
            } catch(e){}
        }

        function saveAmendedBooking(e) {
            e.preventDefault();
            const vias = Array.from(document.querySelectorAll('.amend-via-input')).map(i => i.value.trim()).filter(v => v !== '');
            socket.emit('admin_amend_booking', {
                id: document.getElementById('amendJobId').value,
                passenger: document.getElementById('amendPassenger').value.trim(),
                phone: document.getElementById('amendPhone').value.trim(),
                pickup: document.getElementById('amendPickup').value.trim(),
                vias: vias,
                dropoff: document.getElementById('amendDropoff').value.trim(),
                vehicleClass: document.getElementById('amendVehClass').value,
                fare: parseFloat(document.getElementById('amendFare').value),
                customerNotes: document.getElementById('amendNotes').value.trim(),
                reason: document.getElementById('amendNotes').value.trim()
            });
            closeAppModal('modalAmendJob');
        }

        function openTripHistoryModal(jobId) {
            const j = allJobs.find(x => x.id === jobId);
            if (!j) return;
            document.getElementById('histJobRef').textContent = `📜 Lifecycle History: ${j.id}`;
            document.getElementById('histJobOverview').innerHTML = `
                <div><strong>Passenger:</strong> ${j.passenger} (${j.phone})</div>
                <div><strong>Route:</strong> ${j.pickup} ➔ ${j.dropoff}</div>
                <div><strong>Driver:</strong> ${j.assignedDriverId || 'Unassigned'} | <strong>Total Fare:</strong> £${Number(j.fare).toFixed(2)}</div>
            `;
            const timeline = document.getElementById('histTimeline');
            timeline.innerHTML = '';
            let logs = [];
            try { logs = JSON.parse(j.dispatchAuditLog || '[]'); } catch(e){}
            if (logs.length === 0) {
                timeline.innerHTML = '<div style="color:#64748b;">No recorded events yet.</div>';
            } else {
                logs.forEach(l => {
                    timeline.innerHTML += `
                        <div class="timeline-item">
                            <strong style="color:#38bdf8;">${l.action}</strong> <span style="color:#94a3b8; font-size:0.75rem;">(${l.time})</span><br>
                            <span>${l.note}</span>
                        </div>
                    `;
                });
            }
            openAppModal('modalTripHistory');
        }

        function openReassignModal(jobId) {
            const j = allJobs.find(x => x.id === jobId);
            if (!j) return;
            document.getElementById('reassignJobId').value = j.id;
            document.getElementById('reassignJobSummary').innerHTML = `Job ${j.id}: ${j.passenger} | Current: <strong>${j.assignedDriverId || 'None'}</strong>`;
            toggleReassignOptions();
            openAppModal('modalReassignJob');
        }

        function toggleReassignOptions() {
            const isRecall = document.getElementById('reassignActionType').value === 'RECALL_TO_BASE';
            document.getElementById('reassignDriverSelectWrapper').style.display = isRecall ? 'none' : 'block';
        }

        function executeReassignment(e) {
            e.preventDefault();
            const jId = document.getElementById('reassignJobId').value;
            const action = document.getElementById('reassignActionType').value;
            const targetDriver = (action === 'RECALL_TO_BASE') ? 'UNASSIGNED' : document.getElementById('reassignTargetDriver').value;
            const reason = document.getElementById('reassignReason').value.trim();
            socket.emit('admin_reassign_booking', { jobId: jId, action, newDriverId: targetDriver, reason });
            closeAppModal('modalReassignJob');
        }

        function openCancelModal(jobId) {
            const j = allJobs.find(x => x.id === jobId);
            if (!j) return;
            document.getElementById('cancelJobId').value = j.id;
            document.getElementById('cancelJobSummary').textContent = `Cancel ${j.id} (${j.passenger} - £${Number(j.fare).toFixed(2)})?`;
            openAppModal('modalCancelJob');
        }

        function executeCancellation(e) {
            e.preventDefault();
            socket.emit('admin_cancel_booking', { jobId: document.getElementById('cancelJobId').value, reason: document.getElementById('cancelReason').value.trim() });
            closeAppModal('modalCancelJob');
        }

        function recalculateDispatchFare() {
            if (customPricingActive) return;

            const dropoff = document.getElementById('jobDropoff').value.trim().toLowerCase();
            const vClass = document.getElementById('jobVehClass').value;
            const petType = document.getElementById('jobPetType').value;
            const hasPet = (petType === 'Dog' || petType === 'Cat');
            const viaCount = document.querySelectorAll('.via-input').length;
            const pricingMode = document.getElementById('pricingModeToggle').value;
            const busySurge = parseFloat(document.getElementById('tfBusySurgePct').value) || 0.0;

            let airportMatch = allAirports.find(a => (a.name && dropoff.includes(a.name.toLowerCase())) || (a.iataCode && dropoff.includes(a.iataCode.toLowerCase())));

            if (airportMatch) {
                let base = parseFloat(airportMatch.baseRate);
                let airMult = 1.0;
                if (vClass === 'Estate') airMult += (parseFloat(document.getElementById('tfAirportEstatePct').value) || 10) / 100.0;
                else if (vClass === 'MPV_6') airMult += (parseFloat(document.getElementById('tfAirportMpvPct').value) || 45) / 100.0;
                else if (vClass === 'Minibus_7') airMult += (parseFloat(document.getElementById('tfAirportMinibus7Pct').value) || 60) / 100.0;
                else if (vClass === 'Minibus_8') airMult += (parseFloat(document.getElementById('tfAirportMinibus8Pct').value) || 60) / 100.0;
                else if (vClass === 'Executive') airMult += (parseFloat(document.getElementById('tfAirportExecPct').value) || 70) / 100.0;

                let finalFare = (base * airMult) + (viaCount * (parseFloat(document.getElementById('tfViaStopFee').value) || 5.00)) + (hasPet ? (parseFloat(document.getElementById('tfPetSurcharge').value) || 6.00) : 0);
                if (busySurge > 0) finalFare = finalFare * (1 + (busySurge / 100.0));

                document.getElementById('jobFare').value = finalFare.toFixed(2);
                document.getElementById('dispatchPricingLabel').textContent = `Fixed Airport (${airportMatch.name})`;
                return;
            }

            if (dispatchCalculatedMiles > 0) {
                if (pricingMode === 'meter') {
                    const totalYards = dispatchCalculatedMiles * 1760;
                    const pulses = Math.ceil(totalYards / (parseInt(document.getElementById('tfPulseYard').value) || 176));
                    let meterBase = parseFloat(document.getElementById('tfMeterBaseFare').value) || 3.50;
                    
                    let meterUplift = 1.0;
                    if (vClass === 'Estate') meterUplift += (parseFloat(document.getElementById('tfMeterEstatePct').value) || 10) / 100.0;
                    else if (vClass === 'MPV_6') meterUplift += (parseFloat(document.getElementById('tfMeterMpvPct').value) || 40) / 100.0;
                    else if (vClass === 'Minibus_7') meterUplift += (parseFloat(document.getElementById('tfMeterMinibus7Pct').value) || 60) / 100.0;
                    else if (vClass === 'Minibus_8') meterUplift += (parseFloat(document.getElementById('tfMeterMinibus8Pct').value) || 60) / 100.0;
                    else if (vClass === 'Executive') meterUplift += (parseFloat(document.getElementById('tfMeterExecPct').value) || 70) / 100.0;

                    let baseFare = (meterBase + (pulses * (parseFloat(document.getElementById('tfPulseCost').value) || 0.20))) * meterUplift;
                    baseFare += (viaCount * (parseFloat(document.getElementById('tfViaStopFee').value) || 5.00)) + (hasPet ? (parseFloat(document.getElementById('tfPetSurcharge').value) || 6.00) : 0);

                    if (busySurge > 0) baseFare = baseFare * (1 + (busySurge / 100.0));

                    document.getElementById('jobFare').value = baseFare.toFixed(2);
                    document.getElementById('dispatchPricingLabel').textContent = `Live Digital Pulse Meter`;
                } else {
                    const progressiveFare = calculateProgressiveTariff(dispatchCalculatedMiles, vClass, viaCount, hasPet);
                    document.getElementById('jobFare').value = progressiveFare.toFixed(2);
                    document.getElementById('dispatchPricingLabel').textContent = `Progressive Distance (${dispatchCalculatedMiles}m)`;
                }
            } else {
                let startFee = (pricingMode === 'meter') ? (parseFloat(document.getElementById('tfMeterBaseFare').value) || 3.50) : (parseFloat(document.getElementById('tfBaseFlagDrop').value) || 5.00);
                if (busySurge > 0) startFee = startFee * (1 + (busySurge / 100.0));
                document.getElementById('jobFare').value = startFee.toFixed(2);
            }

            document.getElementById('dispatchDistLabel').textContent = `${dispatchCalculatedMiles} Miles (${viaCount} Via${viaCount === 1 ? '' : 's'})`;
        }

        let dispatchDebounceTimer = null;
        function triggerDispatchAutoRouting() {
            recalculateDispatchFare();
            clearTimeout(dispatchDebounceTimer);

            dispatchDebounceTimer = setTimeout(async () => {
                const pickup = document.getElementById('jobPickup').value.trim();
                const dropoff = document.getElementById('jobDropoff').value.trim();
                const vias = Array.from(document.querySelectorAll('.via-input')).map(i => i.value.trim()).filter(v => v !== '');

                if (!pickup || !dropoff) return;
                const stops = [pickup, ...vias, dropoff];

                try {
                    const geocode = async (addr) => {
                        const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&countrycodes=gb&limit=1&q=${encodeURIComponent(addr)}`);
                        const d = await res.json();
                        return (d && d.length > 0) ? `${d[0].lon},${d[0].lat}` : null;
                    };
                    const coords = await Promise.all(stops.map(s => geocode(s)));
                    if (coords.every(c => c !== null)) {
                        const rRes = await fetch(`https://router.project-osrm.org/route/v1/driving/${coords.join(';')}?overview=false`);
                        const rData = await rRes.json();
                        if (rData.routes && rData.routes.length > 0) {
                            dispatchCalculatedMiles = parseFloat((rData.routes[0].distance * 0.000621371).toFixed(1));
                            recalculateDispatchFare();
                        }
                    }
                } catch(e){}
            }, 450);
        }

        function createJob(e) {
            if (e && e.preventDefault) e.preventDefault();

            const getV = (id) => {
                const el = document.getElementById(id);
                return el ? el.value.trim() : '';
            };

            const passenger = getV('jobPassenger');
            const phone = getV('jobPhone');
            const pickup = getV('jobPickup');
            const dropoff = getV('jobDropoff');

            if (!passenger || !pickup || !dropoff) {
                alert('Please provide Passenger Name, Pickup Address, and Destination.');
                return false;
            }

            // Collect via stopovers if any exist
            const viaInputs = document.querySelectorAll('#viasContainer input');
            const vias = Array.from(viaInputs).map(inp => inp.value.trim()).filter(Boolean);

            const assignedDriver = getV('jobAssignDriver');
            const fareVal = parseFloat(getV('jobFare')) || 0.00;

            const jobData = {
                passenger: passenger,
                phone: phone,
                pickup: pickup,
                dropoff: dropoff,
                vias: vias,
                fare: fareVal,
                paymentMethod: getV('jobPayMethod') || 'Cash',
                accountNumber: getV('jobAccountSelect') || null,
                vehicleClass: getV('jobVehClass') || 'Standard',
                passengers: parseInt(getV('jobPax')) || 1,
                petType: getV('jobPetType') || 'None',
                customerNotes: getV('jobNotes'),
                assignedDriverId: assignedDriver && assignedDriver !== 'AUTO' ? assignedDriver : null
            };

            console.log('⚡ Dispatching Job:', jobData);
            socket.emit('create_job', jobData);

            // Reset form fields after dispatch
            document.getElementById('bookingForm').reset();
            const viasCont = document.getElementById('viasContainer');
            if (viasCont) viasCont.innerHTML = '';
            
            const distLbl = document.getElementById('dispatchDistLabel');
            if (distLbl) distLbl.innerText = '-';
            const priceLbl = document.getElementById('dispatchPricingLabel');
            if (priceLbl) priceLbl.innerText = '-';

            return false;
        }

        socket.on('job_created_ack', (res) => {
            document.getElementById('bookingForm').reset();
            document.getElementById('viasContainer').innerHTML = '';
            dispatchCalculatedMiles = 0.0;
            recalculateDispatchFare();
            alert(`✓ Booking ${res.jobId} Dispatched Successfully!`);
        });

        function saveTariff(e) {
            e.preventDefault();
            const getVal = (id, def = 0) => { const el = document.getElementById(id); return el ? el.value : def; };
            socket.emit('update_system_tariff', {
                defaultLocalPricingMode: getVal('tfDefaultPricingMode', 'dynamic'),
                busySurgePct: parseFloat(getVal('tfBusySurgePct', 0)),

                meterBaseFare: parseFloat(getVal('tfMeterBaseFare', 3.50)),
                meterDistancePulseYard: parseInt(getVal('tfPulseYard', 176)),
                meterDistancePulseCost: parseFloat(getVal('tfPulseCost', 0.20)),
                meterTimePulseSeconds: parseInt(getVal('tfPulseSec', 45)),

                meterEstatePct: parseFloat(getVal('tfMeterEstatePct', 10)),
                meterMpvPct: parseFloat(getVal('tfMeterMpvPct', 40)),
                meterMinibus7Pct: parseFloat(getVal('tfMeterMinibus7Pct', 60)),
                meterMinibus8Pct: parseFloat(getVal('tfMeterMinibus8Pct', 60)),
                meterExecPct: parseFloat(getVal('tfMeterExecPct', 70)),

                baseFlagDrop: parseFloat(getVal('tfBaseFlagDrop', 5.00)),
                firstMileRate: parseFloat(getVal('tfFirstMileRate', 2.00)),
                tier1PerMile: parseFloat(getVal('tfTier1PerMile', 2.00)),
                tier2PerMile: parseFloat(getVal('tfTier2PerMile', 1.80)),
                tier3PerMile: parseFloat(getVal('tfTier3PerMile', 1.50)),

                freeWaitMins: parseInt(getVal('tfFreeWaitMins', 5)),
                waitingRatePerMin: parseFloat(getVal('tfWaitRate', 0.35)),
                viaStopFee: parseFloat(getVal('tfViaStopFee', 5.00)),
                petSurcharge: parseFloat(getVal('tfPetSurcharge', 6.00)),

                estatePercent: (parseFloat(getVal('tfEstatePct', 10)) || 0) / 100.0,
                mpvPercent: (parseFloat(getVal('tfMpvPct', 40)) || 0) / 100.0,
                minibus7Percent: (parseFloat(getVal('tfMinibus7Pct', 60)) || 0) / 100.0,
                minibus8Percent: (parseFloat(getVal('tfMinibus8Pct', 60)) || 0) / 100.0,
                execPercent: (parseFloat(getVal('tfExecPct', 70)) || 0) / 100.0,

                airportEstatePercent: (parseFloat(getVal('tfAirportEstatePct', 10)) || 0) / 100.0,
                airportMpvPercent: (parseFloat(getVal('tfAirportMpvPct', 45)) || 0) / 100.0,
                airportMinibus7Percent: (parseFloat(getVal('tfAirportMinibus7Pct', 60)) || 0) / 100.0,
                airportMinibus8Percent: (parseFloat(getVal('tfAirportMinibus8Pct', 60)) || 0) / 100.0,
                airportExecPercent: (parseFloat(getVal('tfAirportExecPct', 70)) || 0) / 100.0
            });
            closeAppModal('modalTariff');
        }

        function saveAirport(e) {
            e.preventDefault();
            socket.emit('admin_add_airport', {
                name: document.getElementById('airName').value.trim(),
                iataCode: document.getElementById('airIata').value.trim(),
                keywords: document.getElementById('airKeywords').value.trim(),
                baseRate: parseFloat(document.getElementById('airRate').value)
            });
            document.getElementById('airName').value = '';
            document.getElementById('airIata').value = '';
            document.getElementById('airKeywords').value = '';
            document.getElementById('airRate').value = '';
        }

        function saveDriver(e) {
            e.preventDefault();
            socket.emit('admin_create_driver', {
                driverId: document.getElementById('drvId').value.trim().toUpperCase(),
                name: document.getElementById('drvName').value.trim(),
                phone: document.getElementById('drvPhone').value.trim(),
                pin: document.getElementById('drvPin').value.trim(),
                vehicle: document.getElementById('drvVehicle').value.trim(),
                vehicleClass: document.getElementById('drvClass').value,
                maxPax: parseInt(document.getElementById('drvMaxPax').value) || 4,
                customCommissionPct: parseFloat(document.getElementById('drvCommPct').value) || 20.0,
                acceptsPets: document.getElementById('drvAcceptsPets').value === '1',
                badgeExpiry: document.getElementById('drvBadgeExp').value,
                motExpiry: document.getElementById('drvMotExp').value,
                insuranceExpiry: document.getElementById('drvInsExp').value
            });
            document.getElementById('drvId').value = '';
            document.getElementById('drvName').value = '';
            document.getElementById('drvVehicle').value = '';
        }

        function savePlot(e) {
            e.preventDefault();
            socket.emit('admin_add_plot', {
                name: document.getElementById('plotName').value.trim(),
                code: document.getElementById('plotCode').value.trim().toUpperCase(),
                postcodeSector: document.getElementById('plotPostcodeSector').value.trim().toUpperCase(),
                plotType: document.getElementById('plotType').value,
                radiusMeters: parseInt(document.getElementById('plotRadius').value) || 350,
                lat: parseFloat(document.getElementById('plotLat').value),
                lng: parseFloat(document.getElementById('plotLng').value)
            });
            document.getElementById('plotName').value = '';
            document.getElementById('plotCode').value = '';
            document.getElementById('plotPostcodeSector').value = '';
        }

        function saveCorporateAccount(e) {
            e.preventDefault();
            socket.emit('admin_create_account', {
                accountNumber: document.getElementById('accNumber').value.trim().toUpperCase(),
                companyName: document.getElementById('accCompany').value.trim(),
                discountPct: parseFloat(document.getElementById('accDiscount').value) || 0.0,
                billingEmail: document.getElementById('accEmail').value.trim(),
                billingAddress: document.getElementById('accAddress').value.trim()
            });
            document.getElementById('accNumber').value = '';
            document.getElementById('accCompany').value = '';
            document.getElementById('accEmail').value = '';
            document.getElementById('accAddress').value = '';
        }

        socket.on('admin_notice', (res) => { alert((res.success ? '✓ ' : '✕ ') + res.message); });
    </script>
</body>
</html>
