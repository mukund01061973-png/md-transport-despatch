            div.innerHTML = `
                <label>Via Stop #${count}:</label>
                <div style="display:flex; gap:4px;">
                    <input type="text" class="via-input" placeholder="e.g. Combe Down" oninput="triggerDispatchAutoRouting()">
                    <button type="button" class="btn-red" style="width:40px; margin:0;" onclick="this.closest('.via-stop-row').remove(); triggerDispatchAutoRouting();">✕</button>
                </div>
            `;
            wrap.appendChild(div);
            triggerDispatchAutoRouting();
        }

        function addAmendViaField(val = '') {
            const wrap = document.getElementById('amendViasContainer');
            const div = document.createElement('div');
            div.className = 'amend-via-row';
            div.style.marginBottom = '6px';
            div.innerHTML = `
                <div style="display:flex; gap:4px;">
                    <input type="text" class="amend-via-input" value="${val}" placeholder="e.g. Combe Down" oninput="recalcAmendRoute()">
                    <button type="button" class="btn-red" style="width:40px; margin:0;" onclick="this.closest('.amend-via-row').remove(); recalcAmendRoute();">✕</button>
                </div>
            `;
            wrap.appendChild(div);
            recalcAmendRoute();
        }

