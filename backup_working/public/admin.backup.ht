                <input type="hidden" id="cancelJobId">
                <p id="cancelJobSummary" style="font-size:0.85rem; color:#94a3b8;">Are you sure?</p>
                <label>Reason:</label><input type="text" id="cancelReason" placeholder="e.g. Passenger cancelled" required>
                <button type="submit" class="btn-red" style="margin-top:8px;">❌ Confirm Cancellation</button>
            </form>
        </div>
    </div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
    <script>
        const socket = io();
        let allAccounts = [], allJobs = [], allDrivers = [], allPlots = [], allAirports = [];
        let currentFilter = 'all';
        let customPricingActive = false;
        let dispatchCalculatedMiles = 0.0;
        let map, driverMarkers = {};

        // 1. MULTI-TENANT SWITCHER
        function switchTenant() {
            const tenant = document.getElementById('tenantSelect').value;
            socket.emit('set_tenant', tenant);
        }

        // 2. COMPLIANCE CHECK HELPER
        function getComplianceBadge(dateStr) {
            if (!dateStr) return '<span class="badge badge-yellow">No Record</span>';
            const today = new Date();
            const exp = new Date(dateStr);
            const diffDays = Math.ceil((exp - today) / (1000 * 60 * 60 * 24));

            if (diffDays < 0) return `<span class="badge badge-red">EXPIRED (${dateStr})</span>`;
            if (diffDays <= 30) return `<span class="badge badge-yellow">DUE (${diffDays}d)</span>`;
            return `<span class="badge badge-green">VALID (${dateStr})</span>`;
        }

        // 3. PASSENGER LIVE TRACKING LINK
        function openLiveTrackingLink(jobId) {
            const trackUrl = `${window.location.origin}/track.html?job=${jobId}`;
            window.open(trackUrl, '_blank');
        }

        // 4. CORPORATE INVOICE GENERATION
        function generateInvoice(e) {
            e.preventDefault();
            const acc = document.getElementById('invAccountSelect').value;
            const start = document.getElementById('invStartDate').value;
            const end = document.getElementById('invEndDate').value;
            socket.emit('generate_corporate_invoice', { accountNumber: acc, startDate: start, endDate: end });
        }

        socket.on('invoice_result', (res) => {
            if (res.error) return alert('Invoice Error: ' + res.error);
            document.getElementById('invoiceRenderArea').style.display = 'block';
            document.getElementById('invRenderNum').textContent = res.invoiceNumber;
            document.getElementById('invRenderDate').textContent = res.dateGenerated;
            document.getElementById('invRenderTerms').textContent = res.account.paymentTerms || '30 Days Net';
            document.getElementById('invRenderClientCompany').textContent = `${res.account.companyName} (${res.account.accountNumber})`;
            document.getElementById('invRenderClientAddress').textContent = res.account.billingAddress || res.account.billingEmail || 'On Record';

            const tbody = document.getElementById('invRenderTableBody');
            tbody.innerHTML = '';
            res.jobs.forEach(j => {
                tbody.innerHTML += `
                    <tr style="border-bottom:1px solid #cbd5e1;">
                        <td style="padding:6px; color:#000;">${j.createdAt.split(' ')[0]}</td>
                        <td style="padding:6px; color:#000;"><strong>${j.id}</strong></td>
                        <td style="padding:6px; color:#000;">${j.passenger}</td>
                        <td style="padding:6px; color:#000;"><small>${j.pickup} ➔ ${j.dropoff}</small></td>
                        <td style="padding:6px; text-align:right; font-weight:bold; color:#000;">£${Number(j.fare).toFixed(2)}</td>
                    </tr>
                `;
            });

            document.getElementById('invRenderSubtotal').textContent = `£${res.subtotal.toFixed(2)}`;
            document.getElementById('invRenderDiscount').textContent = `-£${res.discount.toFixed(2)} (${res.account.discountPct}%)`;
            document.getElementById('invRenderTotal').textContent = `£${res.totalDue.toFixed(2)}`;
        });

        // ADDRESS AUTOCOMPLETE
        let typeaheadTimer = null;
        function handleAddressTypeahead(inputEl, listId) {
            clearTimeout(typeaheadTimer);
            const query = inputEl.value.trim();
            const listEl = document.getElementById(listId);
            
            if (query.length < 3) {
                listEl.style.display = 'none';
                listEl.innerHTML = '';
                triggerDispatchAutoRouting();
                return;
            }

            typeaheadTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`https://nominatim.openstreetmap.org/search?format=json&countrycodes=gb&addressdetails=1&limit=5&q=${encodeURIComponent(query)}`);
                    const data = await res.json();
                    if (!data || data.length === 0) { listEl.style.display = 'none'; return; }
                    listEl.innerHTML = '';
                    data.forEach(item => {
                        const li = document.createElement('li');
                        li.className = 'typeahead-item';
                        li.textContent = item.display_name.split(',').slice(0, 4).join(',');
                        li.onclick = () => {
                            inputEl.value = li.textContent;
                            listEl.style.display = 'none';
                            listEl.innerHTML = '';
                            triggerDispatchAutoRouting();
                        };
                        listEl.appendChild(li);
                    });
                    listEl.style.display = 'block';
                } catch(e) {}
            }, 300);
        }

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.typeahead-wrap')) {
                document.querySelectorAll('.typeahead-list').forEach(l => l.style.display = 'none');
            }
        });

        // ONE-CLICK RETURN TRIP
        function cloneAsReturnJob(jobId) {
            const j = allJobs.find(x => x.id === jobId);
            if (!j) return;
            document.getElementById('jobPassenger').value = j.passenger;
            document.getElementById('jobPhone').value = j.phone;
            document.getElementById('jobVehClass').value = j.vehicleClass || 'ANY';
            document.getElementById('jobPax').value = j.passengers || 1;
            document.getElementById('jobPayMethod').value = j.paymentMethod || 'Cash';
            document.getElementById('jobAccountSelect').value = j.accountNumber || '';
            document.getElementById('jobPickup').value = j.dropoff;
            document.getElementById('jobDropoff').value = j.pickup;
            document.getElementById('viasContainer').innerHTML = '';
            document.getElementById('jobNotes').value = `Return trip for ${j.passenger}`;
            triggerDispatchAutoRouting();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // DRIVER STATEMENTS
        function openDriverStatementModal() {
            const sel = document.getElementById('stmtDriverSelect');
            sel.innerHTML = '';
            allDrivers.forEach(d => {
                sel.innerHTML += `<option value="${d.driverId}">${d.driverId} - ${d.name} (${d.customCommissionPct}% Cut)</option>`;
            });
            fetchDriverStatement();
            openAppModal('modalDriverStatements');
        }

        function fetchDriverStatement() {
            const driverId = document.getElementById('stmtDriverSelect').value;
            if (!driverId) return;
            socket.emit('get_driver_statement', { driverId });
        }

        socket.on('driver_statement_result', (res) => {
            if (res.error) return alert(res.error);
            const s = res.summary;
            document.getElementById('stmtTripCount').textContent = s.jobCount;
            document.getElementById('stmtGrossFare').textContent = `£${s.grossFare.toFixed(2)}`;
            document.getElementById('stmtCommPct').textContent = s.commissionPct;
            document.getElementById('stmtCommOwed').textContent = `£${s.commissionOwed.toFixed(2)}`;
            const netEl = document.getElementById('stmtNetBalance');
            netEl.textContent = `£${s.netSettlement.toFixed(2)}`;
            netEl.style.color = (s.netSettlement >= 0) ? '#38bdf8' : '#ef4444';

            const tbody = document.getElementById('stmtJobsTableBody');
            tbody.innerHTML = '';
            if (res.completedJobs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:#64748b; padding:12px;">No completed trips on record for this driver.</td></tr>';
                return;
